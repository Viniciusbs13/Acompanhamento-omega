rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(obj) {
      return isSignedIn() && (!('ownerId' in obj) || obj.ownerId == request.auth.uid);
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User Profile
    match /users/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId && 
        incoming().keys().hasAll(['managerName', 'theme']) && 
        incoming().managerName is string && incoming().managerName.size() <= 100 &&
        (!('trafficPanelUrl' in incoming()) || (incoming().trafficPanelUrl is string && incoming().trafficPanelUrl.size() <= 1000));
      allow update: if isSignedIn() && request.auth.uid == userId && 
        incoming().diff(existing()).affectedKeys().hasOnly(['managerName', 'theme', 'trafficPanelUrl']) &&
        incoming().managerName is string &&
        (!('trafficPanelUrl' in incoming()) || (incoming().trafficPanelUrl is string && incoming().trafficPanelUrl.size() <= 1000));
    }

    // Clients
    match /clients/{clientId} {
      function isValidClient(data) {
        return data.name is string && data.name.size() <= 150 &&
               data.businessType in ['SERVICE_BOOKING', 'ECOMMERCE', 'B2B_LEADS', 'WHATSAPP', 'INFO_PRODUCTS', 'REAL_ESTATE', 'LOCAL_BUSINESS', 'VIDEO_PRODUCTION', 'CONTENT_EDITING', 'LAUNCH'] &&
               data.ownerId == request.auth.uid &&
               data.brandColor is string &&
               data.get('accessInfo', []) is list &&
               data.smartGoal is map;
      }

      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(clientId) && isValidClient(incoming());
      allow update: if isSignedIn() && isOwner(existing()) && isValidClient(incoming()) &&
                    incoming().ownerId == existing().ownerId;
      allow delete: if isSignedIn() && isOwner(existing());

      // Metric Entries (Sub-collection)
      match /entries/{entryId} {
        function isValidEntry(data, cid) {
          return data.clientId == cid &&
                 (data.investment is int || data.investment is float) &&
                 data.date is string &&
                 data.ownerId == request.auth.uid;
        }

        allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
        allow get: if isSignedIn() && resource.data.ownerId == request.auth.uid;
        allow create: if isSignedIn() && isValidId(entryId) && isValidEntry(incoming(), clientId);
        allow update: if isSignedIn() && isOwner(existing()) && isValidEntry(incoming(), clientId) &&
                      incoming().ownerId == existing().ownerId;
        allow delete: if isSignedIn() && isOwner(existing());
      }
    }

    // Collection Group support for Metric Entries
    match /{path=**}/entries/{entryId} {
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Sales Registry
    match /sales/{saleId} {
      function isValidSale(data) {
        return data.clientId is string && data.clientId.size() <= 128 &&
               (data.value is int || data.value is float) &&
               data.date is string && data.date.size() <= 64 &&
               data.status in ['PAID', 'PENDING'] &&
               data.ownerId == request.auth.uid;
      }

      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(saleId) && isValidSale(incoming());
      allow update: if isSignedIn() && isOwner(existing()) && isValidSale(incoming()) &&
                    incoming().ownerId == existing().ownerId;
      allow delete: if isSignedIn() && isOwner(existing());
    }

    // Commercial Goals
    match /goals/{goalId} {
      function isValidGoal(data) {
        return (data.month is int || data.month is float) &&
               (data.year is int || data.year is float) &&
               (data.target is int || data.target is float) &&
               (data.get('notes', '') is string) &&
               data.ownerId == request.auth.uid;
      }

      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(goalId) && isValidGoal(incoming());
      allow update: if isSignedIn() && isOwner(existing()) && isValidGoal(incoming()) &&
                    incoming().ownerId == existing().ownerId;
      allow delete: if isSignedIn() && isOwner(existing());
    }

    // Monthly Payments
    match /payments/{paymentId} {
      function isValidPayment(data) {
        return data.clientId is string &&
               (data.month is int || data.month is float) &&
               (data.year is int || data.year is float) &&
               data.status in ['PAID', 'PENDING'] &&
               (data.value is int || data.value is float) &&
               data.ownerId == request.auth.uid;
      }

      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(paymentId) && isValidPayment(incoming());
      allow update: if isSignedIn() && isOwner(existing()) && isValidPayment(incoming()) &&
                    incoming().ownerId == existing().ownerId;
      allow delete: if isSignedIn() && isOwner(existing());
    }

    // Financial Releases (FOLHA)
    match /financial_releases/{releaseId} {
      function isValidRelease(data) {
        return data.date is string && data.date.size() <= 64 &&
               data.description is string && data.description.size() <= 300 &&
               data.category is string && data.category.size() <= 100 &&
               data.type in ['RECEITA', 'GASTO', 'INVESTIMENTO'] &&
               (data.value is int || data.value is float) &&
               (!('observation' in data) || (data.observation is string && data.observation.size() <= 1000)) &&
               data.ownerId == request.auth.uid;
      }

      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(releaseId) && isValidRelease(incoming());
      allow update: if isSignedIn() && isOwner(existing()) && isValidRelease(incoming()) &&
                    incoming().ownerId == existing().ownerId;
      allow delete: if isSignedIn() && isOwner(existing());
    }

    // Recurring Bills
    match /recurring_bills/{billId} {
      function isValidBill(data) {
        return data.description is string && data.description.size() <= 300 &&
               (data.value is int || data.value is float) &&
               (data.dueDay is int || data.dueDay is float) && data.dueDay >= 1 && data.dueDay <= 31 &&
               data.ownerId == request.auth.uid;
      }

      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(billId) && isValidBill(incoming());
      allow update: if isSignedIn() && isOwner(existing()) && isValidBill(incoming()) &&
                    incoming().ownerId == existing().ownerId;
      allow delete: if isSignedIn() && isOwner(existing());
    }

    // Financial Goals
    match /financial_goals/{goalId} {
      function isValidFinancialGoal(data) {
        return (data.month is int || data.month is float) &&
               (data.year is int || data.year is float) &&
               (data.target is int || data.target is float) &&
               data.ownerId == request.auth.uid;
      }

      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(goalId) && isValidFinancialGoal(incoming());
      allow update: if isSignedIn() && isOwner(existing()) && isValidFinancialGoal(incoming()) &&
                    incoming().ownerId == existing().ownerId;
      allow delete: if isSignedIn() && isOwner(existing());
    }

    // Creatives (Traffic Creative Intelligence)
    match /creatives/{creativeId} {
      function isValidCreative(data) {
        return data.code is string &&
               data.title is string && data.title.size() <= 200 &&
               data.status in ['IDEIA', 'PRODUZIDO', 'EDITADO', 'TESTE_CAMPANHA', 'VALIDADO', 'DESCARTADO'] &&
               data.type is string &&
               data.objective is string &&
               data.creationDate is string &&
               (data.rating is int || data.rating is float) && data.rating >= 1 && data.rating <= 5 &&
               data.ownerId == request.auth.uid;
      }

      allow list: if isSignedIn() && (!('ownerId' in resource.data) || resource.data.ownerId == request.auth.uid);
      allow get: if isSignedIn() && (!('ownerId' in resource.data) || resource.data.ownerId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(creativeId) && isValidCreative(incoming());
      allow update: if isSignedIn() && isOwner(existing()) && isValidCreative(incoming()) &&
                    incoming().ownerId == existing().ownerId;
      allow delete: if isSignedIn() && isOwner(existing());
    }
  }
}
