{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User specific settings and profile data.",
      "type": "object",
      "properties": {
        "managerName": { "type": "string" },
        "theme": { "type": "string", "enum": ["light", "dark"] },
        "trafficPanelUrl": { "type": "string" }
      },
      "required": ["managerName", "theme"]
    },
    "Client": {
      "title": "Client",
      "description": "A client managed by the user.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "accountManager": { "type": "string" },
        "logo": { "type": "string" },
        "brandColor": { "type": "string" },
        "businessType": { "type": "string", "enum": ["SERVICE_BOOKING", "ECOMMERCE", "B2B_LEADS", "WHATSAPP", "INFO_PRODUCTS", "REAL_ESTATE", "LOCAL_BUSINESS", "VIDEO_PRODUCTION", "CONTENT_EDITING"] },
        "smartGoal": { "$ref": "SmartGoal" },
        "channels": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "ownerId": { "type": "string" },
        "customFunnelSteps": { "type": "array" },
        "ownerNames": { "type": "string" },
        "planValue": { "type": "number" },
        "planScope": { "type": "string" },
        "contractUrl": { "type": "string" },
        "managementStatus": { "type": "string", "enum": ["GREEN", "YELLOW", "RED"] },
        "billingModel": { "type": "string", "enum": ["RECURRING", "ONE_OFF"] }
      },
      "required": ["name", "brandColor", "businessType", "smartGoal", "ownerId"]
    },
    "SmartGoal": {
      "title": "Smart Goal",
      "type": "object",
      "properties": {
        "currentRevenue": { "type": "number" },
        "targetRevenue": { "type": "number" },
        "durationMonths": { "type": "number" },
        "adSpend": { "type": "number" },
        "funnelSteps": { "type": "array" },
        "ticket": { "type": "number" }
      }
    },
    "MetricEntry": {
      "title": "Metric Entry",
      "description": "Monthly performance metrics for a client.",
      "type": "object",
      "properties": {
        "clientId": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "investment": { "type": "number" },
        "leads": { "type": "number" },
        "bookings": { "type": "number" },
        "shows": { "type": "number" },
        "sales": { "type": "number" },
        "revenue": { "type": "number" },
        "profit": { "type": "number" },
        "cac": { "type": "number" },
        "sessions": { "type": "number" },
        "addCart": { "type": "number" },
        "checkouts": { "type": "number" },
        "purchases": { "type": "number" },
        "mqls": { "type": "number" },
        "meetings": { "type": "number" },
        "proposals": { "type": "number" },
        "waClicks": { "type": "number" },
        "waConversations": { "type": "number" },
        "qualifiedLeads": { "type": "number" },
        "customData": { "type": "object" },
        "ownerId": { "type": "string" }
      },
      "required": ["clientId", "date", "investment", "ownerId"]
    },
    "Sale": {
      "title": "Sale",
      "description": "A single sale record.",
      "type": "object",
      "properties": {
        "clientId": { "type": "string" },
        "clientName": { "type": "string" },
        "service": { "type": "string" },
        "value": { "type": "number" },
        "date": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["PAID", "PENDING"] },
        "origin": { "type": "string" },
        "ownerId": { "type": "string" }
      },
      "required": ["clientId", "value", "date", "status", "ownerId"]
    },
    "CommercialGoal": {
      "title": "Commercial Goal",
      "description": "Monthly commercial target/goal.",
      "type": "object",
      "properties": {
        "month": { "type": "number" },
        "year": { "type": "number" },
        "target": { "type": "number" },
        "ownerId": { "type": "string" }
      },
      "required": ["month", "year", "target", "ownerId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile and settings."
    },
    "/clients/{clientId}": {
      "schema": "Client",
      "description": "Clients collection."
    },
    "/clients/{clientId}/entries/{entryId}": {
      "schema": "MetricEntry",
      "description": "Metric entries sub-collection for each client."
    },
    "/sales/{saleId}": {
      "schema": "Sale",
      "description": "Sales collection."
    },
    "/goals/{goalId}": {
      "schema": "CommercialGoal",
      "description": "Goals collection."
    }
  }
}
